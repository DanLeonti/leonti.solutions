{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leonti-solutions",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "leonti.solutions", "custom_domain": true },
    { "pattern": "www.leonti.solutions", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
